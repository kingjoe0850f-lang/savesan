# Copy this file to .env and fill in your own values.
# .env is gitignored — never commit real API keys.

# Get this from https://resend.com/api-keys after creating a free account.
# Leave blank to run in dev mode: codes print to the server console instead
# of being emailed, so you can test the whole flow before signing up for anything.
RESEND_API_KEY=

# Must be an address on a domain you've verified in Resend, OR the shared
# onboarding@resend.dev address (works immediately, no domain setup, but
# Resend restricts it to sending only to the email you signed up to Resend with).
FROM_EMAIL=SaveSan <onboarding@resend.dev>

PORT=3001

# Once deployed, set this to your real frontend URL (e.g.
# https://savesan.netlify.app) to restrict who can call this API.
# Leave as * for local testing.
ALLOWED_ORIGIN=*
